# Copy to .env and set your TypeSafe API key locally.
# Load it into the shell: set -a; . ./.env; set +a
TYPESAFE_API_KEY=

# Required by `serve`. PostgreSQL credentials belong only on the server.
# Remote connections require verified TLS. Local example (replace credentials):
# POLYROVER_DATABASE_URL=postgresql://polyrover:CHANGE_ME@127.0.0.1:5432/polyrover
POLYROVER_DATABASE_URL=
